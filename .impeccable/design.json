  "narrative": {
    "northStar": "La Ficha Técnica",
    "overview": "Cada página se lee como la hoja de especificaciones de un equipo industrial: datos exactos, etiquetas técnicas, una retícula de plano de fondo y un solo color de señal que marca lo importante. Plano por defecto; la profundidad aparece solo como respuesta a un estado.",
    "keyCharacteristics": [
      "Papel claro (paper) con tinta grafito (ink) y un único acento naranja señal.",
      "Archivo expandido en mayúsculas para titulares y etiquetas; Public Sans para leer.",
      "Retícula de plano de 64 px que se desvanece, solo en los héroes y en el 404.",
      "Líneas finas de 1 px como estructura; reglas de 2 px en tinta para abrir listas.",
      "Fotografía en escala de grises con marcas de esquina.",
      "Movimiento con transform/opacity y ease-out-expo; alternativas con movimiento reducido."
    ],
    "rules": [
      {
        "name": "The One Signal Rule",
        "body": "El naranja es la única voz de color. Se reserva para la acción principal, la señal activa y la posición (índice, foco). Nunca se introduce un segundo acento.",
        "section": "colors"
      },
      {
        "name": "The Contrast Floor Rule",
        "body": "Texto naranja de menos de 18.66 px (o 14 px bold) solo sobre paper o paper-raised; sobre paper-sunken se usa signal-orange-deep.",
        "section": "colors"
      },
      {
        "name": "The Spec Label Rule",
        "body": "Toda micro-etiqueta en mayúsculas usa el rol Label; no se redefine en cada componente.",
        "section": "typography"
      },
      {
        "name": "The No Wrap Display Rule",
        "body": "El display nunca parte palabras: su tamaño se deriva del ancho de su contenedor.",
        "section": "typography"
      },
      {
        "name": "The Spec Sheet Rule",
        "body": "La información comparable (datos, coberturas, pasos) se presenta en filas o columnas con líneas finas, como una ficha; las tarjetas se reservan para objetos navegables (seguros) o casos (escenarios).",
        "section": "layout"
      },
      {
        "name": "The Flat Paper Rule",
        "body": "Ninguna tarjeta tiene sombra en reposo. Si algo necesita separarse, primero se intenta una línea o un cambio de superficie.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do usar signal-orange solo para acción principal, señal activa y foco.",
      "Do presentar datos comparables como ficha: filas con líneas finas y etiquetas Label.",
      "Do desaturar todas las fotografías y enmarcarlas con marcas de esquina.",
      "Do animar solo transform y opacity, con ease-out-expo, entre 180 y 720 ms, y dar una alternativa con prefers-reduced-motion.",
      "Do dar alternativa táctil a todo efecto de cursor (hover: none)."
    ],
    "donts": [
      "Don't introducir un segundo color de acento ni degradados decorativos (la retícula de plano y la luz radial del hero son las únicas excepciones).",
      "Don't usar radios mayores a 8 px fuera del dock y los puntos de estado.",
      "Don't poner sombras en reposo ni bordes laterales gruesos de color como acento.",
      "Don't usar fotografía a color ni imágenes que no correspondan a la operación descrita.",
      "Don't usar texto naranja pequeño sobre paper-sunken."
    ]
  }
}
