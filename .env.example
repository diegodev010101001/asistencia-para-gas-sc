# Copia este archivo a .env.local (desarrollo) o define las variables en
# Vercel → Project → Settings → Environment Variables.

# ─── Dominio ──────────────────────────────────────────────────────────────
# TODO: dominio final. Base de canonical, Open Graph, sitemap y JSON-LD.
NEXT_PUBLIC_SITE_URL=https://DOMINIO.com

# ─── Envío del formulario de cotización (elige UNA opción) ───────────────
# Opción A · Webhook (Zapier, Make, n8n, Formspree, endpoint propio).
# Recibe un POST JSON con los datos de la solicitud.
QUOTE_WEBHOOK_URL=

# Opción B · Correo con Resend (https://resend.com).
RESEND_API_KEY=
QUOTE_TO_EMAIL=
QUOTE_FROM_EMAIL=
