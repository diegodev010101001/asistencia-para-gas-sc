# Plantilla de variables de entorno. Copia este archivo a .env.local
# (desarrollo) o define las variables en Vercel → Settings → Environment Variables.

# ─── EmailJS (formulario de cotización) ───────────────────────────────────
# Sin prefijo NEXT_PUBLIC_: se leen solo en el servidor y nunca llegan al navegador.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# ─── Dominio ──────────────────────────────────────────────────────────────
# TODO: dominio final. Base de canonical, Open Graph, sitemap y JSON-LD.
NEXT_PUBLIC_SITE_URL=
